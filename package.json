{
  "name": "blightghp",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:brain-gif": "node scripts/gen_brain_gif.js",
    "sync:brain-gif": "npm run build:wasm && npm run generate:brain-gif",
    "verify:brain-gif": "node scripts/verify_brain_gif.js",
    "check:shadow-replay": "node scripts/shadow_replay.js",
    "test:wasm-browser": "node scripts/verify_wasm_worker.js",
    "verify:presentation-navigation": "node scripts/verify_presentation_navigation.js",
    "audit:runtime": "node scripts/audit_runtime.js",
    "audit:hardware": "node scripts/audit_runtime.js",
    "audit:material": "node scripts/audit_material_profile.js",
    "audit:light-materiality": "node scripts/audit_light_materiality.js",
    "audit:anatomy": "node scripts/audit_anatomical_catalog.js",
    "audit:vascular": "node scripts/audit_vascular_topology.js",
    "audit:presentation-budget": "node scripts/audit_presentation_budget.js",
    "verify:presentation-budget": "node scripts/verify_presentation_budget.js",
    "audit:procedural-surface": "node scripts/audit_procedural_surface.js",
    "verify:procedural-surface": "node scripts/verify_procedural_surface.js",
    "verify:docs": "node scripts/verify_document_links.js",
    "verify:automation": "node scripts/verify_automation_policy.js",
    "verify:runtime-audit": "node scripts/verify_runtime_audit.js",
    "verify:light-materiality": "node scripts/verify_light_materiality.js",
    "verify:hardware-audit": "node scripts/verify_hardware_audit.js",
    "verify:promotion-0.8": "node scripts/verify_promotion_0_8.js",
    "build:wasm": "cargo build -p brain-wasm --release --target wasm32-unknown-unknown && wasm-bindgen target/wasm32-unknown-unknown/release/brain_wasm.wasm --out-dir src/wasm --target web --typescript",
    "stamp:brain-gif": "node scripts/stamp_brain_gif.js",
    "check": "npm run typecheck && npm run verify:automation && npm run verify:docs && npm run check:shadow-replay && npm run test && npm run build && npm run test:wasm-browser && npm run verify:presentation-navigation && npm run verify:promotion-0.8 && npm run verify:presentation-budget && npm run verify:procedural-surface && npm run audit:runtime"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "gif-encoder-2": "^1.0.5",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.3.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
